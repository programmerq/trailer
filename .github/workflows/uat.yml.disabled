# Tag-triggered UAT workflow — disabled by default.
#
# Renamed to `.yml` once the harness matures. Intent:
#   - Run only on `git tag` pushes (release candidates).
#   - Run only on Linux for now; that's all the Docker image supports.
#   - Uses the same container as scripts/run-uat.sh so local and CI
#     runs stay in lockstep.
#
# Until enabled, UAT lives in Docker on developer machines.

name: UAT

on:
  push:
    tags:
      - 'v*'

jobs:
  uat:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Build UAT image
        run: docker build -t trailer-uat -f docker/uat/Dockerfile .
      - name: Run UAT suite
        run: docker run --rm -v "$PWD":/work -w /work trailer-uat \
               bash scripts/run-uat.sh --in-container
