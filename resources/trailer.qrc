        <file alias="tool-arrow-filled.svg">icons/actions/tool-arrow-filled.svg</file>
        <file alias="tool-freehand.svg">icons/actions/tool-freehand.svg</file>
        <file alias="tool-text.svg">icons/actions/tool-text.svg</file>
        <file alias="tool-note.svg">icons/actions/tool-note.svg</file>
