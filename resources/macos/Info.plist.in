<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
                      "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
    <key>CFBundleIconFile</key>
    <string>${MACOSX_BUNDLE_ICON_FILE}</string>
    <!--
        Adaptive (light/dark) app icon — ADR 0009 Option A. Names the
        AppIcon set compiled from resources/macos/Assets.xcassets into
        Contents/Resources/Assets.car by actool (see CMakeLists.txt).
        Coexists with the legacy CFBundleIconFile above: macOS that reads
        the asset catalog picks up the appearance-adaptive icon, while
        pre-catalog paths fall back to the static trailer.icns.
    -->
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>CFBundleIdentifier</key>
    <string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleVersion</key>
    <string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>

    <!--
        Empty in normal builds. Recorder-enabled builds
        (-DTRAILER_ENABLE_UX_RECORDER=ON) substitute the camera
        usage-description key here — macOS refuses (kills the
        process, in fact) any camera-permission request from a
        bundle without it. See docs/ux-recorder.md.
    -->
    ${TRAILER_UX_PLIST_EXTRAS}

    <!--
        Declare which document types Trailer opens. Without this,
        macOS won't dispatch QFileOpenEvent when the user drags a
        file onto the Dock icon, double-clicks a file with
        "Trailer" set as the default opener, or right-clicks → Open
        With → Trailer. The handlerRank is "Alternate" because
        Trailer isn't registered as the system-wide PDF / image
        opener — Preview owns that role; we just want to be in the
        Open With submenu.
    -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>PDF Document</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.adobe.pdf</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Image</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.image</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
