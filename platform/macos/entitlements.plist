<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened Runtime entitlements for Trailer.app.
  TODO: Add Apple Developer Team ID and signing identity before notarization.
-->
<plist version="1.0">
<dict>
    <!-- Disallow JIT compilation (not needed for a document viewer) -->
    <key>com.apple.security.cs.allow-jit</key>
    <false/>

    <!-- Disallow unsigned executable memory -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <false/>

    <!-- Allow reading user-selected files (open panel) -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
</dict>
</plist>
